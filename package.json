{
  "name": "@asenajs/ergenecore",
  "module": "index.ts",
  "description": "Ergenecore is native bun server adapter for asenajs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "version": "3.2.1",
  "author": "LibirSoft",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build": "bun run clean && tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "benchmark": "bun run benchmark/run-benchmark.ts",
    "benchmark:native": "bun run benchmark/native-bun.ts",
    "benchmark:ergenecore": "bun run benchmark/ergenecore.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@asenajs/asena": "^0.11.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "eslint-config-alloy": "^5.1.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-alloy": "^1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@asenajs/asena": "^0.11.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
